<?xml version="1.0" encoding="utf-8"?>
<!--
   Reguły kopii zapasowej dla API < 31. Domyślnie do kopii Google szło WSZYSTKO, w tym
   credentials.xml z szyfrogramem hasła do crowncaps. Klucz AES siedzi w Android Keystore
   i urządzenia nie opuszcza, więc szyfrogram w chmurze jest bezużyteczny — ale nie ma tam
   czego szukać. Baza cci.db zostaje w kopii: odtworzenie kolekcji jest tego warte.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="credentials.xml"/>
</full-backup-content>
